meta {
  name: Registrar gasto
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/grupos/{{grupoId}}/gastos
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
  Cookie: uid={{uid}}
}

body:json {
  { "descripcion": "Mercado", "montoCentavos": 4000000, "pagadorUid": "usuario-demo", "participantes": ["usuario-demo", "otro-usuario"] }
}
