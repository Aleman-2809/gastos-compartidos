{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npx prettier --write src)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm publish:*)",
      "Bash(npx vercel:*)",
      "Bash(npx firebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/*credentials*.json)",
      "Read(**/*service-account*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(~/**)",
      "Read(../**)",
      "Read(//etc/**)",
      "Edit(../**)",
      "Write(../**)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(cat .env:*)",
      "Bash(cat ~/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Glob|Grep|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/ia/guardia.mjs\"" }]
      }
    ]
  }
}
